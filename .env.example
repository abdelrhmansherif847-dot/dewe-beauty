# Public values (safe in the browser). Find them in Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Canonical site URL, used for auth email redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The storefront does not need a secret/service-role key. If a future admin
# feature does, add it in Vercel as a Sensitive variable named
# SUPABASE_SECRET_KEY and only read it in server-only modules.
