# Public values (safe in the browser). Find them in Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Canonical site URL, used for auth email redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only, never NEXT_PUBLIC_. Guest checkout creates orders with it
# (src/lib/supabase/service.ts). On Vercel: Sensitive, Production only.
# Locally use the SERVICE_ROLE_KEY printed by `npx supabase status -o env`.
SUPABASE_SECRET_KEY=
